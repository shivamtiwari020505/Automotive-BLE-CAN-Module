	(text "R302/R303/C309: DNP for a stub. Populate together only at a bus end (120.8 ohm)."
		(exclude_from_sim no)
		(at 19.05 22.5 0)
		(effects
			(font
				(size 1 1)
			)
			(justify left top)
		)
		(uuid "80bfb080-c84e-4d78-bb39-a07082e298a1")
	)
	(text "C305+C310: >=10uF effective at 5V. C306: >=300nF effective. Verify MLCC bias/aging.\nCAN operation requires valid VSUP and VIO >=3V; no CAN communication on backup-only power."
		(exclude_from_sim no)
		(at 82.55 164.846 0)
		(effects
			(font
				(size 1 1)
			)
			(justify left top)
		)
		(uuid "ccaffcf8-5155-4035-b4b0-414d108ac6c3")
	)
	(text "FW: SPI mode 0, <=18 MHz; RST active HIGH.\nSet 0x0800[19]=1 for nWKRQ VIO/open-drain\nbefore sleep; [8]=1 selects wake interrupt mode.\nDefault nWKRQ is 3.6 V: verify MCU rail sequencing."
		(exclude_from_sim no)
		(at 168.08 123.73 0)
		(effects
			(font
				(size 1 1)
			)
			(justify left top)
		)
		(uuid "ddd31dac-a7b7-41b1-862a-dfb5190c79fe")
	)
	(text "PCB: TVS at connector; short bypass/ground paths.\nGround exposed pad. Keep crystal loop compact.\nR311=0R initially; tune with C303/C304 per SLLA549.\n"
		(exclude_from_sim no)
		(at 168.08 144.73 0)
		(effects
			(font
				(size 1 1)
			)
			(justify left top)
		)
		(uuid "e3a86fe1-4880-4092-8d60-8abe1fe8b044")
	)
