	(text "LAYOUT / BRING-UP CHECKS\nPlace input/output capacitors close to their IC pins; keep ORing\ncurrent paths and ground returns short. Verify output-cap effective\ncapacitance, maximum-load transfer dip, battery-only MCU operation,\nand battery-voltage accuracy over temperature before fabrication."
		(exclude_from_sim no)
		(at 317.5 122.936 0)
		(effects
			(font
				(size 1.2 1.2)
			)
			(justify left top)
		)
		(uuid "0fa067ba-e2f2-427d-b861-fec9e603abaa")
	)
	(text "SCHEMATIC REV A  |  replaceable externally-charged 1S pack  |  NO onboard charging  |  vehicle-priority diode-OR"
		(exclude_from_sim no)
		(at 67.31 31.75 0)
		(effects
			(font
				(size 1.3 1.3)
			)
			(justify left top)
		)
		(uuid "327240ef-a227-4952-9ab2-792b17db5f5f")
	)
	(text "BATTERY INPUT / PROTECTION\nJ401: polarized, externally charged 1S pack (3.0-4.2 V). No onboard charger.\nF401 is board-fault protection; pack must have its own PCM.\nR402 limits hot-plug current; U401 blocks reverse insertion/current.\nVerify pack-pigtail polarity against J401 pinout before insertion."
		(exclude_from_sim no)
		(at 46.736 93.218 0)
		(effects
			(font
				(size 1.2 1.2)
			)
			(justify left top)
		)
		(uuid "5cf7172f-d97a-4948-a127-ba87266f18f1")
	)
	(text "04  BATTERY BACKUP / VEHICLE-BATTERY POWER PATH"
		(exclude_from_sim no)
		(at 67.31 25.4 0)
		(effects
			(font
				(size 2 2)
			)
			(justify left top)
		)
		(uuid "8b3740aa-19ca-4331-8bd2-a03f902d7e7d")
	)
	(text "BATTERY REGULATION / MONITORING\nU402 generates the nominal 3.0 V backup rail.\nR403/R404/C404 filter VBAT_SENSE; connect this label to the MCU ADC\nif battery monitoring is required. TP401/TP402/TP403 provide the main supply and ground probes."
		(exclude_from_sim no)
		(at 231.648 104.14 0)
		(effects
			(font
				(size 1.2 1.2)
			)
			(justify left top)
		)
		(uuid "9fde31b2-61be-4e65-9898-a8173e227dc7")
	)
	(text "SOURCE SELECTION / STATUS\nU403/U404 form the diode-OR: vehicle rail has nominal priority,\nbackup takes over when vehicle rail falls. USING_BATTERY_N is\nan active-low, open-drain status from U404 ST with R405 pull-up.\nU401/U403 unused open-drain ST pins are tied to GND per TI LM66100-Q1."
		(exclude_from_sim no)
		(at 234.442 141.732 0)
		(effects
			(font
				(size 1.2 1.2)
			)
			(justify left top)
		)
		(uuid "e0d421ec-7b2d-4518-a7cc-624c263ecc05")
	)
