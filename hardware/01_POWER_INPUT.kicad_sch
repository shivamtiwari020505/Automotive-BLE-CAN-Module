	(text "SCHEMATIC |  9-36 V nominal operating input  "
		(exclude_from_sim no)
		(at 19.05 22.86 0)
		(effects
			(font
				(size 1.25 1.25)
			)
			(justify left top)
		)
		(uuid "094c425f-b00e-403a-bfde-bd99840fae21")
	)
	(text "LAYOUT INTENT (PCB NOT IMPLEMENTED)\nKeep C106 + ceramic bank at U101 VIN/GND; smallest hot loop.\nMinimize SW copper; L101 marked short lead to SW.\nSense FB after L101 at output capacitors; away from SW/BOOT.\nConnect both IC exposed pads to GND copper + thermal vias.\nKeep a continuous ground plane; separate surge/switching returns\nby placement/routing, not by breaking the reference plane.\nTarget >=1.0 mm external-node clearance; verify fab / pollution / surge."
		(exclude_from_sim no)
		(at 271.272 219.71 0)
		(effects
			(font
				(size 1.15 1.15)
			)
			(justify left top)
		)
		(uuid "290446b4-0e66-4e50-8d35-a8a6e0a1746d")
	)
	(text "100 mA 3V3 design allocation; LDO nominal loss 0.319 W.\nDo NOT connect a battery directly to +3V3_VEH.\nFuture power mux must block reverse current into U102.\nPWR_GOOD_VEH is not valid as a battery-only rail monitor."
		(exclude_from_sim no)
		(at 215.646 186.182 0)
		(effects
			(font
				(size 1.15 1.15)
			)
			(justify left top)
		)
		(uuid "35ecfdef-e7ec-4c08-8dc6-994694b28cd1")
	)
	(text "A. FUSED CLAMP + REVERSE BATTERY + DAMPED INPUT FILTER"
		(exclude_from_sim no)
		(at 19.05 31.75 0)
		(effects
			(font
				(size 1.5 1.5)
			)
			(justify left top)
		)
		(uuid "504d440e-cf48-4542-884e-bfc9692c4acc")
	)
	(text "Internal compensation, soft start and synchronous rectification.\nNo COMP network / catch diode / external bootstrap diode.\n6.49 V supports TCAN4550 VSUP (6 V minimum), with 9 V input headroom.\nEN typ: ON 6.04 V / OFF 5.31 V at VIN_FILTERED; see corner calculations.\nUVLO is not a guarantee of valid CAN operation during brownout."
		(exclude_from_sim no)
		(at 19.05 186.69 0)
		(effects
			(font
				(size 1.15 1.15)
			)
			(justify left top)
		)
		(uuid "57202305-77bd-4486-9fb9-66c2c5baf39a")
	)
	(text "Scope: only this power sheet. No +5V rail is required by the selected architecture.\nDesign is non-isolated. Never use GND as a substitute for a specified chassis connection.\nNo LED load added; test pads provide bring-up access without continuous drain."
		(exclude_from_sim no)
		(at 129.794 215.392 0)
		(effects
			(font
				(size 1.15 1.15)
			)
			(justify left top)
		)
		(uuid "5d0844cb-1ae6-4b05-bcd9-d55bdb829b59")
	)
	(text "F101 is NOT a precision current limiter. Use a suitably fused vehicle harness.\nD101 return: short/wide to J101 return; keep surge current away from logic.\nBidirectional D101 avoids forward conduction on a reversed battery."
		(exclude_from_sim no)
		(at 19.05 87.63 0)
		(effects
			(font
				(size 1.15 1.15)
			)
			(justify left top)
		)
		(uuid "7e82022b-5140-48b4-87db-367be5ef1b3b")
	)
	(text "D101: 40 V stand-off; 64.5 V max clamp at 102 A, 10/1000 us, 25 degC.\n80 V buck / 100 V input capacitors. Hot clamp + PCB overshoot must be checked.\n"
		(exclude_from_sim no)
		(at 208.534 90.17 0)
		(effects
			(font
				(size 1.15 1.15)
			)
			(justify left top)
		)
		(uuid "87defc53-57b4-4392-aa48-068c7bb00aa6")
	)
