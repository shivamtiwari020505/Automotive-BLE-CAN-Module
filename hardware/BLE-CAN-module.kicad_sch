	(text "SHEET INDEX\n01   POWER INPUT ............ 9-36 V protection, 6.49 V buck, 3.3 V LDO\n02   BLE CONTROLLER ......... CC2340R53, clocks, RF front-end, SWD\n03   CAN INTERFACE .......... TCAN4550-Q1, CMC, TVS, split termination\n04   BATTERY BACKUP ......... 1S pack input, 3.0 V LDO, ideal-diode ORing"
		(exclude_from_sim no)
		(at 186 88 0)
		(effects
			(font
				(size 1.2 1.2)
			)
			(justify left top)
		)
		(uuid "1b0f0cb6-cc00-4575-82ee-67a49fb3afcb")
	)
	(text "POWER INPUT 9-36 V\nConversion to 6V5 and +3V3"
		(exclude_from_sim no)
		(at 56.388 61.976 0)
		(effects
			(font
				(size 1.27 1.27)
				(thickness 0.254)
				(bold yes)
			)
		)
		(uuid "25bed3a6-e61d-4879-b81f-f49ec30e7bbc")
	)
	(text "KEY DEVICES\nU201  CC2340R53E0RKPR   BLE 5.x MCU, 512 KB flash, QFN-40\nU301  TCAN4550RGYRQ1    CAN FD controller + transceiver, SPI\nU101  LMR38010SQDDARQ1  80 V buck, PFM, spread spectrum\nU102  TPS7B8133QDGNRQ1  40 V LDO, 2.7 uA Iq\nU402  TPS7E8130QDBVRQ1  40 V LDO, 2.8 uA Iq\nU401/3/4 LM66100QDCKRQ1 ideal diode / reverse-current block\nL301  ACT45B-101-2P     CAN common-mode choke"
		(exclude_from_sim no)
		(at 19.05 120 0)
		(effects
			(font
				(size 1.15 1.15)
			)
			(justify left top)
		)
		(uuid "2e759e30-47a0-416f-9ee3-1f58d3c67139")
	)
	(text "Vehicle CAN bus to Bluetooth LE bridge  |  9-36 V input  |  1S Li-ion backup"
		(exclude_from_sim no)
		(at 19.05 20.5 0)
		(effects
			(font
				(size 1.5 1.5)
			)
			(justify left top)
		)
		(uuid "30c3700d-681a-47e0-80e4-3efca881ac0c")
	)
	(text "POWER TREE\nJ101 9-36 V -> F101 -> D101 TVS / D102 reverse -> R101 damping\n   -> U101 LMR38010-Q1 buck ........ +6V5_CAN  (TCAN4550 VSUP)\n        -> U102 TPS7B8133-Q1 LDO ... +3V3_VEH\nJ401 1S pack -> F401 -> U401 RCB -> U402 TPS7E8130-Q1 ... +3V0_BAT\n   U403 / U404 LM66100-Q1 ideal-diode OR .... +3V3_SYS  (MCU + VIO)\nVehicle rail has priority by the 3.3 V / 3.0 V offset; battery takes\nover automatically on vehicle loss. CAN is unavailable in backup."
		(exclude_from_sim no)
		(at 111.252 128.27 0)
		(effects
			(font
				(size 1.15 1.15)
			)
			(justify left top)
		)
		(uuid "5bd18527-8ba1-4bfc-bf3c-af7681428be6")
	)
	(text "AUTOMOTIVE BLE-CAN MODULE"
		(exclude_from_sim no)
		(at 19.05 14 0)
		(effects
			(font
				(size 3.2 3.2)
				(bold yes)
			)
			(justify left top)
		)
		(uuid "69280fe2-4750-4814-97c6-b16d9e1b3de8")
	)
	(text "Mounting Holes (M2)"
		(exclude_from_sim no)
		(at 52.578 141.732 0)
		(effects
			(font
				(size 1.27 1.27)
			)
		)
		(uuid "71745cf2-a39c-44bf-ba0b-67de52fea545")
	)
	(text "BOARD / PROCESS\n4-layer FR4, 1.58 mm: F.Cu signal / In1 GND / In2 power / B.Cu GND\n49.5 x 56.9 mm, single-sided assembly, HAL lead-free\nConformal coating REQUIRED - input spacing designed to IPC-2221 B4\nRF feed is 50 ohm controlled impedance - see Output_Files/FAB_NOTES.md"
		(exclude_from_sim no)
		(at 19.05 168 0)
		(effects
			(font
				(size 1.15 1.15)
			)
			(justify left top)
		)
		(uuid "9f2a7df8-011d-44ba-8827-02c76db99b62")
	)
